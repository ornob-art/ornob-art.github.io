---
// Footer.astro

// ফুটারে থাকা সকল তথ্য এখান থেকে খুব সহজেই পরিবর্তন করতে পারবেন
const footerData = {
  about: {
    text: "শূন্য থেকে অনন্তের মননশীল সন্ধান "
  },
  categories: [
    { label: "সাহিত্য ও কাব্য", url: "/category/সাহিত্য", dataCategory: "সাহিত্য" },
    { label: "কথাসাহিত্য ও গল্প", url: "/category/কথাসাহিত্য", dataCategory: "কথাসাহিত্য" },
    { label: "দর্শন ও সমাজভাবনা", url: "/category/দর্শন", dataCategory: "দর্শন" },
    { label: "বিজ্ঞান ও প্রযুক্তি", url: "/category/বিজ্ঞান", dataCategory: "বিজ্ঞান" },
    { label: "ভ্রমণ ও ঐতিহ্য", url: "/category/ভ্রমণ", dataCategory: "ভ্রমণ" }
  ],
  quickLinks: [
    { label: "প্রচ্ছদ", url: "/#home" },
    { label: "সম্পাদকীয় পর্ষদ", url: "/#home" },
    { label: "যোগাযোগ", url: "/contact" },
    { label: "পুরনো সংখ্যাসমূহ (আর্কাইভ)", url: "/#home" },
    { label: "গোপনীয়তা নীতি", url: "/#home" }
  ],
  contact: {
    email: "ornob336699@gmail.com",
    address: "ঢাকা, বাংলাদেশ"
  },
  socialLinks: [
    { name: "Facebook", url: "/#home", iconSVG: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>` },
    { name: "Twitter", url: "/#home", iconSVG: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>` },
    { name: "YouTube", url: "/#home", iconSVG: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>` }
  ],
  copyright: "© ২০২৬ সুবর্ণপত্র • সর্বস্বত্ব সংরক্ষিত।",
  tagline: "সুবর্ণপত্র বাংলা প্রকাশনা ও ডিজিটাল শিল্পকর্ম"
};
---
<!-- Site Footer -->
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <h2 class="brand-title">সুবর্ণ<span>পত্র</span></h2>
        <p>{footerData.about.text}</p>
      </div>

      <div>
        <h4 class="footer-col-title">সূচীপত্র</h4>
        <ul class="footer-links">
          {footerData.categories.map(cat => (
            <li><a href={cat.url} data-category={cat.dataCategory}>{cat.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="footer-col-title">অনুষঙ্গ</h4>
        <ul class="footer-links">
          {footerData.quickLinks.map(link => (
            <li><a href={link.url}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="footer-col-title">যোগাযোগ</h4>
        <ul class="footer-links">
          <li><span style="color: #9ca3af;">ইমেইল: {footerData.contact.email}</span></li>
          <li><span style="color: #9ca3af;">{footerData.contact.address}</span></li>
        </ul>
        <div class="social-icons" style="margin-top: 1.25rem;">
          {footerData.socialLinks.map(social => (
            <a href={social.url} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label={social.name} set:html={social.iconSVG} />
          ))}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>{footerData.copyright}</p>
      <p>{footerData.tagline}</p>
    </div>
  </div>
</footer>
