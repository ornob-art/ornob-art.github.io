---
// src/components/Header.astro
import { getCollection } from 'astro:content';
import { getAutoBadge, getAutoExcerpt } from '../utils';

const posts = await getCollection('posts');
const searchData = posts.map(post => ({
  id: post.id,
  slug: post.slug,
  title: post.data.title || '',
  author: post.data.author || '',
  category: post.data.category || '',
  badge: getAutoBadge(post),
  excerpt: getAutoExcerpt(post),
  image: post.data.image || null
}));
---

<style is:global>
  .search-container {
    position: relative;
  }
  .search-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: #ffffff;
    border: 1px solid #e8e2d5;
    border-radius: 10px;
    box-shadow: 0 10px 28px rgba(35, 25, 10, 0.15);
    z-index: 9999;
    max-height: 380px;
    overflow-y: auto;
  }
  .search-result-item {
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #f0ece2;
    text-decoration: none;
    color: #1e2022;
    transition: background-color 0.2s ease;
  }
  .search-result-item:last-child {
    border-bottom: none;
  }
  .search-result-item:hover {
    background-color: #f2eee5;
  }
  .search-result-thumb {
    width: 46px;
    height: 46px;
    border-radius: 6px;
    overflow: hidden;
    margin-right: 0.85rem;
    flex-shrink: 0;
    background: #1e293b;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .search-result-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .search-result-content {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .search-result-cat {
    font-size: 0.75rem;
    color: #b47214;
    font-weight: 600;
    margin-bottom: 0.15rem;
  }
  .search-result-title {
    font-family: 'Noto Serif Bengali', serif;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
    color: #1e2022;
    margin: 0;
  }
  .search-empty {
    padding: 1.25rem;
    text-align: center;
    color: #787f8a;
    font-size: 0.9rem;
  }
</style>

<!-- Top Metadata Bar -->
<div class="top-bar">
  <div class="container">
    <div class="top-meta">
      <div class="top-meta-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
          <line x1="16" x2="16" y1="2" y2="6"></line>
          <line x1="8" x2="8" y1="2" y2="6"></line>
          <line x1="3" x2="21" y1="10" y2="10"></line>
        </svg>
        <span id="current-bengali-date"></span>
      </div>
      <div class="top-meta-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <span>নান্দনিক বাংলা সাহিত্যের সাময়িকী • অনলাইন সংস্করণ</span>
      </div>
    </div>
    <div class="top-meta">
      <div class="top-meta-item">
        <span>শূন্য থেকে অনন্তের মননশীল সন্ধান</span>
      </div>
    </div>
  </div>
</div>

<!-- Main Site Header -->
<header class="site-header" id="header">
  <div class="container">
    <div class="header-main">
      <!-- Brand Title & Logo -->
      <a href="/" class="brand" aria-label="সুবর্ণপত্র প্রচ্ছদ">
        <div class="brand-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m18 2-7.5 7.5"></path>
            <path d="m22 7-7.5 7.5"></path>
            <path d="m2 22 5.5-1.5L21.3 6.7a2.83 2.83 0 0 0-4-4L3.5 16.5 2 22z"></path>
            <circle cx="11.5" cy="11.5" r="1"></circle>
          </svg>
        </div>
        <div class="brand-text">
          <h1 class="brand-title">সুবর্ণ<span>পত্র</span></h1>
          <span class="brand-tagline">শূন্য থেকে অনন্তের মননশীল সন্ধান</span>
        </div>
      </a>

      <!-- Search Box -->
      <div class="search-container" id="search-container">
        <div class="search-input-wrapper">
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" x2="16.65" y1="21" y2="16.65"></line>
          </svg>
          <input 
            type="text" 
            class="search-input" 
            id="search-input" 
            placeholder="লেখা খুঁজুন..." 
            aria-label="Search articles"
            autocomplete="off"
          >
          <button class="search-clear-btn" id="search-clear-btn" aria-label="Clear search">✕</button>
        </div>
        <div id="search-dropdown-results" class="search-dropdown" style="display: none;"></div>
      </div>

      <!-- Mobile Hamburger Toggle -->
      <button class="hamburger" id="hamburger-btn" aria-label="মেনু খুলুন" aria-expanded="false" aria-controls="nav-menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" x2="21" y1="6" y2="6"></line>
          <line x1="3" x2="21" y1="12" y2="12"></line>
          <line x1="3" x2="21" y1="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Navigation Menu Bar -->
  <div class="nav-wrapper">
    <div class="container">
      <nav class="navbar" aria-label="Main Menu">
        <ul class="nav-menu" id="nav-menu">
          <li><a href="/" class="nav-link active" data-category="all">প্রচ্ছদ</a></li>
          <li><a href="/#articles" class="nav-link" data-category="সাহিত্য">সাহিত্য ও শিল্প</a></li>
          <li><a href="/#articles" class="nav-link" data-category="কথাসাহিত্য">কথাসাহিত্য</a></li>
          <li><a href="/#articles" class="nav-link" data-category="দর্শন">দর্শন ও সমাজ</a></li>
          <li><a href="/#articles" class="nav-link" data-category="বিজ্ঞান">বিজ্ঞান ও প্রযুক্তি</a></li>
          <li><a href="/#articles" class="nav-link" data-category="ভ্রমণ">ভ্রমণ ও ঐতিহ্য</a></li>
          <li><a href="#newsletter" class="nav-link">যোগাযোগ</a></li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<script is:inline define:vars={{ searchData }}>
  window.SEARCH_DATA = searchData;

  const initRealtimeSearch = () => {
    const rawInput = document.getElementById('search-input');
    const rawClearBtn = document.getElementById('search-clear-btn');
    const searchContainer = document.getElementById('search-container');
    const dropdownResults = document.getElementById('search-dropdown-results');

    if (!rawInput || !rawClearBtn || !dropdownResults) return;

    // পুরনো ক্যাশ হওয়া স্ক্রিপ্টের ইভেন্ট লিসেনার ও এরর মেসেজ সম্পূর্ণ মুছে ফেলা
    const searchInput = rawInput.cloneNode(true);
    rawInput.parentNode.replaceChild(searchInput, rawInput);

    const searchClearBtn = rawClearBtn.cloneNode(true);
    rawClearBtn.parentNode.replaceChild(searchClearBtn, rawClearBtn);

    if (searchContainer) {
      Array.from(searchContainer.children).forEach(child => {
        if (!child.classList.contains('search-input-wrapper') && child.id !== 'search-dropdown-results') {
          child.remove();
        }
      });
    }

    const resolveImg = (img) => {
      if (!img || typeof img !== 'string') return null;
      return (img.startsWith('http') || img.startsWith('/')) ? img : `/${img}`;
    };

    const runSearch = (rawQuery) => {
      // যদি কোনো পুরনো স্ক্রিপ্ট এরর ডিভ তৈরি করে থাকে তা মুছে ফেলা
      if (searchContainer) {
        Array.from(searchContainer.children).forEach(child => {
          if (!child.classList.contains('search-input-wrapper') && child.id !== 'search-dropdown-results') {
            child.remove();
          }
        });
      }

      const query = (rawQuery || '').toLowerCase().trim();
      const postCards = document.querySelectorAll('.post-card');
      const featuredArticle = document.getElementById('featured-article');
      const noResults = document.getElementById('no-results');

      if (!query) {
        searchClearBtn.style.display = 'none';
        dropdownResults.style.display = 'none';
        if (featuredArticle) featuredArticle.style.display = 'block';
        postCards.forEach(card => card.style.display = 'flex');
        if (noResults) noResults.style.display = 'none';
        return;
      }

      searchClearBtn.style.display = 'block';
      const allData = window.SEARCH_DATA || [];

      const matchedPosts = allData.filter(post => {
        return (post.title && post.title.toLowerCase().includes(query)) ||
               (post.excerpt && post.excerpt.toLowerCase().includes(query)) ||
               (post.author && post.author.toLowerCase().includes(query)) ||
               (post.category && post.category.toLowerCase().includes(query)) ||
               (post.badge && post.badge.toLowerCase().includes(query));
      });

      // ১. সব পেজেই সার্চ বক্সের নিচে তাৎক্ষণিক ড্রপডাউন ফলাফল দেখানো
      dropdownResults.style.display = 'block';
      if (matchedPosts.length === 0) {
        dropdownResults.innerHTML = '<div class="search-empty">দুঃখিত, কোনো লেখা পাওয়া যায়নি</div>';
      } else {
        dropdownResults.innerHTML = matchedPosts.map(post => {
          const imgPath = resolveImg(post.image);
          return `
            <a href="/posts/${post.slug}" class="search-result-item">
              <div class="search-result-thumb">
                ${imgPath ? `<img src="${imgPath}" alt="">` : '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>'}
              </div>
              <div class="search-result-content">
                <span class="search-result-cat">${post.badge || post.category} • ${post.author}</span>
                <h4 class="search-result-title">${post.title}</h4>
              </div>
            </a>
          `;
        }).join('');
      }

      // ২. হোমপেজে থাকলে নিচের কার্ডগুলোও রিয়েল-টাইমে ফিল্টার করা
      if (postCards.length > 0 || featuredArticle) {
        let hasVisible = false;

        if (featuredArticle) {
          const text = (featuredArticle.textContent || '').toLowerCase();
          const isMatch = text.includes(query) || matchedPosts.some(p => featuredArticle.innerHTML.includes(p.title));
          featuredArticle.style.display = isMatch ? 'block' : 'none';
          if (isMatch) hasVisible = true;
        }

        postCards.forEach(card => {
          const text = (card.textContent || '').toLowerCase();
          const isMatch = text.includes(query) || matchedPosts.some(p => card.innerHTML.includes(p.title));
          card.style.display = isMatch ? 'flex' : 'none';
          if (isMatch) hasVisible = true;
        });

        if (noResults) {
          noResults.style.display = hasVisible ? 'none' : 'block';
        }
      }
    };

    searchInput.addEventListener('input', (e) => runSearch(e.target.value));
    searchInput.addEventListener('focus', (e) => {
      if (e.target.value.trim()) runSearch(e.target.value);
    });

    searchClearBtn.addEventListener('click', () => {
      searchInput.value = '';
      runSearch('');
      searchInput.focus();
    });

    document.addEventListener('click', (e) => {
      if (searchContainer && !searchContainer.contains(e.target)) {
        dropdownResults.style.display = 'none';
      }
    });
  };

  const initMobileMenu = () => {
    const hamburgerBtn = document.getElementById('hamburger-btn');
    const navMenu = document.getElementById('nav-menu');
    
    if (hamburgerBtn && navMenu) {
      hamburgerBtn.addEventListener('click', () => {
        const isExpanded = hamburgerBtn.getAttribute('aria-expanded') === 'true';
        hamburgerBtn.setAttribute('aria-expanded', !isExpanded);
        navMenu.classList.toggle('active');
        hamburgerBtn.classList.toggle('active');
      });

      // Close menu automatically on link click
      const navLinks = navMenu.querySelectorAll('a');
      navLinks.forEach(link => {
        link.addEventListener('click', () => {
          hamburgerBtn.setAttribute('aria-expanded', 'false');
          navMenu.classList.remove('active');
          hamburgerBtn.classList.remove('active');
        });
      });
    }
  };

  const updateBengaliDate = () => {
    const dateEl = document.getElementById('current-bengali-date');
    if (dateEl) {
      dateEl.textContent = new Intl.DateTimeFormat('bn-BD', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(new Date());
    }
  };

  if (document.readyState === 'complete') {
    setTimeout(initRealtimeSearch, 50);
    setTimeout(initMobileMenu, 50);
    updateBengaliDate();
  } else {
    window.addEventListener('load', () => {
      setTimeout(initRealtimeSearch, 50);
      setTimeout(initMobileMenu, 50);
      updateBengaliDate();
    });
  }
</script>
