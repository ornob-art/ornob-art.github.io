---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const featuredPost = allPosts.find(post => post.data.featured) || allPosts[0];
const regularPosts = allPosts.filter(post => post.id !== featuredPost?.id);

const categoryCounts = allPosts.reduce((acc, post) => {
  const cat = post.data.category;
  acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {});

const categories = [
  { id: 'সাহিত্য', label: 'সাহিত্য ও কাব্য' },
  { id: 'কথাসাহিত্য', label: 'কথাসাহিত্য ও গল্প' },
  { id: 'দর্শন', label: 'দর্শন ও সমাজভাবনা' },
  { id: 'বিজ্ঞান', label: 'বিজ্ঞান ও প্রযুক্তি' },
  { id: 'ভ্রমণ', label: 'ভ্রমণ ও ঐতিহ্য' },
];

const toBengaliNumber = (num) => {
  const banglaDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
  return num?.toString().split('').map(d => banglaDigits[d] || d).join('');
};

// ইমেজ পাথ ঠিক করার ফাংশন (যেকোনো নামেই থাকুক না কেন তা খুঁজে বের করবে)
const getPostImage = (post) => {
  const rawImg = post?.data?.image || post?.data?.cover || post?.data?.coverImage;
  if (!rawImg || typeof rawImg !== 'string') return null;
  if (rawImg.startsWith('http') || rawImg.startsWith('/')) return rawImg;
  return `/${rawImg}`;
};

const featuredImg = getPostImage(featuredPost);
---

<Layout>
  <Header />

  <!-- Main Content Area -->
  <main class="site-main" id="home">
    <div class="container">
      <div class="layout-grid">
        
        <!-- Left Column: Blog Posts & Feeds -->
        <section class="content-column" aria-label="প্রধান রচনা সম্ভার">
          
          <!-- Featured Lead Article (শীর্ষ রচনা) -->
          {featuredPost && (
          <article class="featured-article" id="featured-article" data-category={featuredPost.data.category}>
            <div 
              class="featured-banner" 
              style={featuredImg ? `background-image: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.65)), url('${featuredImg}'); background-size: cover; background-position: center; position: relative;` : 'position: relative;'}
            >
              {!featuredImg && <div class="featured-banner-pattern"></div>}
              <span class="featured-badge" style="position: relative; z-index: 2;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                {featuredPost.data.badge}
              </span>
            </div>
            
            <div class="featured-content">
              <h2 class="featured-title">
                <a href={`/posts/${featuredPost.slug}`} style="color: inherit; text-decoration: none;">{featuredPost.data.title}</a>
              </h2>
              <p class="featured-excerpt">
                {featuredPost.data.excerpt}
              </p>
              
              <div class="article-meta">
                <div class="author-info">
                  <div class="author-avatar">{featuredPost.data.author.charAt(0)}</div>
                  <div class="author-details">
                    <span class="author-name">{featuredPost.data.author}</span>
                    <span class="post-date">{featuredPost.data.date} • পড়ার সময়: {featuredPost.data.readTime}</span>
                  </div>
                </div>
                <a href={`/posts/${featuredPost.slug}`} class="read-more-btn" aria-label="সম্পূর্ণ রচনা পড়ুন" style="text-decoration: none;">
                  <span>সম্পূর্ণ পড়ুন</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </article>
          )}

          <!-- Section Head & Interactive Category Tabs -->
          <div class="section-head" id="articles">
            <h3 class="section-title">সাম্প্রতিক রচনাবলী</h3>
            <div class="filter-tabs">
              <button class="filter-btn active" data-filter="all">সকল রচনা</button>
              <button class="filter-btn" data-filter="সাহিত্য">সাহিত্য</button>
              <button class="filter-btn" data-filter="কথাসাহিত্য">গল্প</button>
              <button class="filter-btn" data-filter="বিজ্ঞান">বিজ্ঞান</button>
              <button class="filter-btn" data-filter="দর্শন">দর্শন</button>
            </div>
          </div>

          <!-- Blog Posts Grid -->
          <div class="posts-grid" id="posts-grid">
            
            {regularPosts.map((post, index) => {
              const bgClass = `thumb-bg-${(index % 6) + 1}`;
              const postImg = getPostImage(post);
              return (
              <article class="post-card" data-category={post.data.category} data-id={index + 1}>
                <div class={`post-card-thumb ${!postImg ? bgClass : ''}`} style="position: relative; overflow: hidden;">
                  <span class="post-card-badge" style="position: relative; z-index: 2;">{post.data.badge}</span>
                  {postImg ? (
                    <img 
                      src={postImg} 
                      alt={post.data.title} 
                      class="post-card-img" 
                      style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; display: block;" 
                    />
                  ) : (
                    <svg class="thumb-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                      <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                    </svg>
                  )}
                </div>
                <div class="post-card-body">
                  <h3 class="post-card-title">
                    <a href={`/posts/${post.slug}`} style="color: inherit; text-decoration: none;">{post.data.title}</a>
                  </h3>
                  <p class="post-card-excerpt">
                    {post.data.excerpt}
                  </p>
                  <div class="post-card-footer">
                    <div class="post-card-author">
                      <span>{post.data.author}</span> • <span>{post.data.date.split(',')[0]}</span>
                    </div>
                    <a href={`/posts/${post.slug}`} class="post-btn-link" style="text-decoration: none;">
                      <span>পড়ুন</span> →
                    </a>
                  </div>
                </div>
              </article>
            )})}

            <!-- Empty Search State -->
            <div class="no-results" id="no-results">
              <div class="no-results-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" x2="16.65" y1="21" y2="16.65"></line>
                </svg>
              </div>
              <h4 class="no-results-text">দুঃখিত, আপনার অনুসন্ধানের সাথে মেলে এমন কোনো লেখা পাওয়া যায়নি।</h4>
              <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.5rem;">অনুগ্রহ করে ভিন্ন কোনো শব্দ বা বিষয় দিয়ে পুনরায় সন্ধান করুন।</p>
            </div>

          </div>
        </section>

        <!-- Right Column: Sidebar (সূচীপত্র ও অনুষঙ্গ) -->
        <aside class="sidebar" aria-label="সূচীপত্র ও অনুষঙ্গ">
          
          <!-- Table of Contents / Categories (সূচীপত্র / বিষয়শ্রেণী) -->
          <div class="widget">
            <h3 class="widget-title">
              <span>সূচীপত্র / বিষয়শ্রেণী</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
            </h3>
            <ul class="toc-list" id="toc-list">
              <li>
                <button class="toc-item-link active" data-category="all">
                  <span class="toc-item-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                    সমগ্র রচনাসমগ্র
                  </span>
                  <span class="toc-item-count">{toBengaliNumber(allPosts.length)}টি</span>
                </button>
              </li>
              {categories.map(cat => (
                <li>
                  <button class="toc-item-link" data-category={cat.id}>
                    <span class="toc-item-title">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                      {cat.label}
                    </span>
                    <span class="toc-item-count">{toBengaliNumber(categoryCounts[cat.id] || 0)}টি</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>

          <!-- Popular / Trending Articles (জনপ্রিয় লেখা) -->
          <div class="widget">
            <h3 class="widget-title">
              <span>জনপ্রিয় লেখা</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
              </svg>
            </h3>
            <ul class="popular-list">
              <li class="popular-item" onclick="window.location.href='/single-post.html'">
                <span class="popular-rank">১</span>
                <div>
                  <h4 class="popular-item-title">রবীন্দ্রনাথের শেষ পর্বের কবিতা: রূপান্তরের আলো ও ছায়া</h4>
                  <span class="popular-item-date">পঠিত: ৩,৪২০ বার</span>
                </div>
              </li>
              <li class="popular-item" onclick="window.location.href='/single-post.html'">
                <span class="popular-rank">২</span>
                <div>
                  <h4 class="popular-item-title">শব্দ ও নীরবতার সীমানায়: আধুনিক মানুষের আত্মানুসন্ধান</h4>
                  <span class="popular-item-date">পঠিত: ২,৯৮০ বার</span>
                </div>
              </li>
              <li class="popular-item" onclick="window.location.href='/single-post.html'">
                <span class="popular-rank">৩</span>
                <div>
                  <h4 class="popular-item-title">কৃত্রিম বুদ্ধিমত্তা ও মানবিক কল্পনাশক্তির ভবিষ্যৎ</h4>
                  <span class="popular-item-date">পঠিত: ২,৬৪০ বার</span>
                </div>
              </li>
              <li class="popular-item" onclick="window.location.href='/single-post.html'">
                <span class="popular-rank">৪</span>
                <div>
                  <h4 class="popular-item-title">মেঘভাঙা রোদ এবং একটি হলুদ খামের গল্প</h4>
                  <span class="popular-item-date">পঠিত: ২,১৫০ বার</span>
                </div>
              </li>
            </ul>
          </div>

          <!-- Weekly Literary Thought (সপ্তাহের সাহিত্য ভাবনা) -->
          <div class="widget quote-widget">
            <h3 class="widget-title">
              <span>সপ্তাহের ভাবনা</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
                <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
              </svg>
            </h3>
            <blockquote class="quote-body">
              “আলো যেমন আঁধারকে স্পর্শ করেই প্রকাশ পায়, তেমনি দুঃখের নিবিড় অনুভূতিই আনন্দের প্রকৃত স্বরূপকে চিনিয়ে দেয়।”
            </blockquote>
            <p class="quote-author">— রবীন্দ্রনাথ ঠাকুর</p>
          </div>

          <!-- Newsletter Signup (সুবর্ণপত্রিকা গ্রাহক) -->
          <div class="widget newsletter-widget" id="newsletter">
            <h3 class="widget-title">
              <span>পত্রিকা গ্রাহক হন</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </h3>
            <p class="newsletter-desc">প্রতি শুক্রবার নতুন সংখ্যা ও নির্বাচিত প্রবন্ধ আপনার ইমেইল ইনবক্সে পেতে বিনামূল্যে যুক্ত থাকুন।</p>
            <form class="newsletter-form" id="newsletter-form">
              <input 
                type="email" 
                class="newsletter-input" 
                placeholder="আপনার ইমেইল ঠিকানা..." 
                required
              >
              <button type="submit" class="newsletter-btn">গ্রাহক হোন</button>
            </form>
          </div>

        </aside>

      </div>
    </div>
  </main>

  <!-- Article Detail Modal Dialog (সম্পূর্ণ রচনা পাঠ) -->
  <div class="modal-backdrop" id="article-modal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal-container">
      <div class="modal-header">
        <span class="modal-badge" id="modal-category">সাহিত্য ও শিল্প</span>
        <button class="modal-close-btn" id="modal-close-btn" aria-label="উইন্ডো বন্ধ করুন">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="modal-body">
        <h2 class="modal-title" id="modal-title">প্রবন্ধের শিরোনাম</h2>
        <div class="modal-meta" id="modal-meta">
          <span id="modal-author">লেখক নাম</span>
          <span>•</span>
          <span id="modal-date">তারিখ</span>
        </div>
        <div class="modal-text" id="modal-content">
          <!-- Dynamic Full Text -->
        </div>
      </div>
    </div>
  </div>

  <Footer />
</Layout>
