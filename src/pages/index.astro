---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />

  <!-- Main Content Area -->
  <main class="site-main" id="home">
    <div class="container">
      <div class="layout-grid">
        
        <!-- Left Column: Blog Posts & Feeds -->
        <section class="content-column" aria-label="প্রধান রচনা সম্ভার">
          
          <!-- Featured Lead Article (শীর্ষ রচনা) -->
          <article class="featured-article" id="featured-article" data-category="দর্শন">
            <div class="featured-banner">
              <div class="featured-banner-pattern"></div>
              <span class="featured-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                শীর্ষ রচনা • দর্শন ও সমাজভাবনা
              </span>
            </div>
            
            <div class="featured-content">
              <h2 class="featured-title">
                <a href="/single-post.html" style="color: inherit; text-decoration: none;">শব্দ ও নীরবতার সীমানায়: আধুনিক মানুষের আত্মানুসন্ধান</a>
              </h2>
              <p class="featured-excerpt">
                আমাদের নিত্যদিনের কোলাহলের অন্তরালে যে নীরবতার সুর বাজে, তা কি আমরা শুনতে পাই? প্রযুক্তির চরম উৎকর্ষের যুগে মানুষের অন্তর্জগতের একাকীত্ব এবং সাহিত্যের আশ্রয়ে মুক্তির পথ নিয়ে এক গভীর পর্যবেক্ষণ ও অনুসন্ধান।
              </p>
              
              <div class="article-meta">
                <div class="author-info">
                  <div class="author-avatar">অ</div>
                  <div class="author-details">
                    <span class="author-name">ড. অনির্বাণ চৌধুরী</span>
                    <span class="post-date">১৫ সেপ্টেম্বর, ২০২৬ • পড়ার সময়: ৭ মিনিট</span>
                  </div>
                </div>
                <a href="/single-post.html" class="read-more-btn" aria-label="সম্পূর্ণ রচনা পড়ুন" style="text-decoration: none;">
                  <span>সম্পূর্ণ পড়ুন</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </article>

          <!-- Section Head & Interactive Category Tabs -->
          <div class="section-head" id="articles">
            <h3 class="section-title">সাম্প্রতিক রচনাবলী</h3>
            <div class="filter-tabs">
              <button class="filter-btn active" data-filter="all">সকল রচনা</button>
              <button class="filter-btn" data-filter="সাহিত্য">সাহিত্য</button>
              <button class="filter-btn" data-filter="কথাসাহিত্য">গল্প</button>
              <button class="filter-btn" data-filter="বিজ্ঞান">বিজ্ঞান</button>
              <button class="filter-btn" data-filter="দর্শন">দর্শন</button>
            </div>
          </div>

          <!-- Blog Posts Grid -->
          <div class="posts-grid" id="posts-grid">
            
            <!-- Post Card 1 -->
            <article class="post-card" data-category="সাহিত্য" data-id="1">
              <div class="post-card-thumb thumb-bg-1">
                <span class="post-card-badge">সাহিত্য সমালোচনা</span>
                <svg class="thumb-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
              </div>
              <div class="post-card-body">
                <h3 class="post-card-title">
                  <a href="/single-post.html" style="color: inherit; text-decoration: none;">রবীন্দ্রনাথের শেষ পর্বের কবিতা: রূপান্তরের আলো ও ছায়া</a>
                </h3>
                <p class="post-card-excerpt">
                  চিত্রলিপি থেকে রোগশয্যায়—জীবনের প্রান্তবেলায় এসে কবির ভাষাবোধ ও দার্শনিক দৃষ্টিতে যে আমূল রূপান্তর ঘটেছিল, তার এক গভীর ও রসঘন পাঠ।
                </p>
                <div class="post-card-footer">
                  <div class="post-card-author">
                    <span>সুস্মিতা সেনগুপ্ত</span> • <span>১২ সেপ্টেম্বর</span>
                  </div>
                  <a href="/single-post.html" class="post-btn-link" style="text-decoration: none;">
                    <span>পড়ুন</span> →
                  </a>
                </div>
              </div>
            </article>

            <!-- Post Card 2 -->
            <article class="post-card" data-category="কথাসাহিত্য" data-id="2">
              <div class="post-card-thumb thumb-bg-2">
                <span class="post-card-badge">ছোটগল্প</span>
                <svg class="thumb-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </div>
              <div class="post-card-body">
                <h3 class="post-card-title">
                  <a href="/single-post.html" style="color: inherit; text-decoration: none;">মেঘভাঙা রোদ এবং একটি হলুদ খামের গল্প</a>
                </h3>
                <p class="post-card-excerpt">
                  পুরনো ডাকবাক্সের এক কোণে জমে থাকা ধুলোমাখা চিঠিটি আজও কাউকে কিছু বলতে চায়। সম্পর্কের ভাঙাগড়া আর স্মৃতির গন্ধমাখা এক হৃদয়স্পর্শী গল্প।
                </p>
                <div class="post-card-footer">
                  <div class="post-card-author">
                    <span>তানভীর আহমেদ</span> • <span>১০ সেপ্টেম্বর</span>
                  </div>
                  <a href="/single-post.html" class="post-btn-link" style="text-decoration: none;">
                    <span>পড়ুন</span> →
                  </a>
                </div>
              </div>
            </article>

            <!-- Post Card 3 -->
            <article class="post-card" data-category="বিজ্ঞান" data-id="3">
              <div class="post-card-thumb thumb-bg-3">
                <span class="post-card-badge">বিজ্ঞান ও প্রযুক্তি</span>
                <svg class="thumb-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="10"></circle>
                  <circle cx="12" cy="12" r="4"></circle>
                  <line x1="4.93" y1="4.93" x2="9.17" y2="9.17"></line>
                  <line x1="14.83" y1="14.83" x2="19.07" y2="19.07"></line>
                </svg>
              </div>
              <div class="post-card-body">
                <h3 class="post-card-title">
                  <a href="/single-post.html" style="color: inherit; text-decoration: none;">কৃত্রিম বুদ্ধিমত্তা ও মানবিক কল্পনাশক্তির ভবিষ্যৎ</a>
                </h3>
                <p class="post-card-excerpt">
                  অ্যালগরিদমের জটিল হিসেবে কি সৃষ্টিশীলতার মৌলিক সুর জন্ম নিতে পারে? যন্ত্রের যুগে মানুষের মানবিক অনুভূতি ও সাহিত্যবোধের টিকে থাকার সংগ্রাম।
                </p>
                <div class="post-card-footer">
                  <div class="post-card-author">
                    <span>নাফিসা রহমান</span> • <span>০৮ সেপ্টেম্বর</span>
                  </div>
                  <a href="/single-post.html" class="post-btn-link" style="text-decoration: none;">
                    <span>পড়ুন</span> →
                  </a>
                </div>
              </div>
            </article>

            <!-- Post Card 4 -->
            <article class="post-card" data-category="ভ্রমণ" data-id="4">
              <div class="post-card-thumb thumb-bg-4">
                <span class="post-card-badge">ভ্রমণ ও প্রকৃতি</span>
                <svg class="thumb-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="m8 3 4 8 5-5 5 15H2L8 3z"></path>
                </svg>
              </div>
              <div class="post-card-body">
                <h3 class="post-card-title">
                  <a href="/single-post.html" style="color: inherit; text-decoration: none;">পাহাড়ের বাঁকে নীরব কুয়াশা: সাজেকের রূপকথা</a>
                </h3>
                <p class="post-card-excerpt">
                  মেঘ আর সবুজ পাহাড়ের মিতালিতে গড়ে ওঠা জনপদের জীবনগাথা। যেখানে সময় যেন থমকে দাঁড়িয়ে থাকে আদিম প্রকৃতির প্রশান্ত সান্নিধ্যে।
                </p>
                <div class="post-card-footer">
                  <div class="post-card-author">
                    <span>প্রিয়ম রায়</span> • <span>০৫ সেপ্টেম্বর</span>
                  </div>
                  <a href="/single-post.html" class="post-btn-link" style="text-decoration: none;">
                    <span>পড়ুন</span> →
                  </a>
                </div>
              </div>
            </article>

            <!-- Post Card 5 -->
            <article class="post-card" data-category="সাহিত্য" data-id="5">
              <div class="post-card-thumb thumb-bg-5">
                <span class="post-card-badge">ঐতিহ্য ও ইতিহাস</span>
                <svg class="thumb-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                  <path d="M3 9h18"></path>
                  <path d="M9 21V9"></path>
                </svg>
              </div>
              <div class="post-card-body">
                <h3 class="post-card-title">
                  <a href="/single-post.html" style="color: inherit; text-decoration: none;">মুঘল ঢাকার স্থাপত্যশৈলী: বিস্মৃতির অতলে এক স্বর্ণযুগ</a>
                </h3>
                <p class="post-card-excerpt">
                  বুড়িগঙ্গার তীরে গড়ে ওঠা সপ্তদশ শতকের সুবিশাল সুবেদারি ইমারতগুলোর অলংকরণ, খিলান ও নির্মাণকলার ঐতিহাসিক তাৎপর্য।
                </p>
                <div class="post-card-footer">
                  <div class="post-card-author">
                    <span>ড. আসিফ মুজতবা</span> • <span>০৩ সেপ্টেম্বর</span>
                  </div>
                  <a href="/single-post.html" class="post-btn-link" style="text-decoration: none;">
                    <span>পড়ুন</span> →
                  </a>
                </div>
              </div>
            </article>

            <!-- Post Card 6 -->
            <article class="post-card" data-category="বিজ্ঞান" data-id="6">
              <div class="post-card-thumb thumb-bg-6">
                <span class="post-card-badge">পরিবেশ ভাবনা</span>
                <svg class="thumb-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 2a10 10 0 0 1 10 10c0 5.523-4.477 10-10 10S2 17.523 2 12A10 10 0 0 1 12 2z"></path>
                  <path d="M12 6v6l4 2"></path>
                </svg>
              </div>
              <div class="post-card-body">
                <h3 class="post-card-title">
                  <a href="/single-post.html" style="color: inherit; text-decoration: none;">জলবায়ু সংকট ও সুন্দরবনের শ্বাসমূলের কান্না</a>
                </h3>
                <p class="post-card-excerpt">
                  লবণাক্ত জলের তীব্র আগ্রাসনে প্রতিনিয়ত বদলে যাচ্ছে উপকূলীয় বাস্তুতন্ত্র। ম্যানগ্রোভ বনাঞ্চল বাঁচিয়ে রাখার বৈজ্ঞানিক ও জরুরি রূপরেখা।
                </p>
                <div class="post-card-footer">
                  <div class="post-card-author">
                    <span>মাহমুদুল হাসান</span> • <span>০১ সেপ্টেম্বর</span>
                  </div>
                  <a href="/single-post.html" class="post-btn-link" style="text-decoration: none;">
                    <span>পড়ুন</span> →
                  </a>
                </div>
              </div>
            </article>

            <!-- Empty Search State -->
            <div class="no-results" id="no-results">
              <div class="no-results-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" x2="16.65" y1="21" y2="16.65"></line>
                </svg>
              </div>
              <h4 class="no-results-text">দুঃখিত, আপনার অনুসন্ধানের সাথে মেলে এমন কোনো লেখা পাওয়া যায়নি।</h4>
              <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.5rem;">অনুগ্রহ করে ভিন্ন কোনো শব্দ বা বিষয় দিয়ে পুনরায় সন্ধান করুন।</p>
            </div>

          </div>
        </section>

        <!-- Right Column: Sidebar (সূচীপত্র ও অনুষঙ্গ) -->
        <aside class="sidebar" aria-label="সূচীপত্র ও অনুষঙ্গ">
          
          <!-- Table of Contents / Categories (সূচীপত্র / বিষয়শ্রেণী) -->
          <div class="widget">
            <h3 class="widget-title">
              <span>সূচীপত্র / বিষয়শ্রেণী</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
            </h3>
            <ul class="toc-list" id="toc-list">
              <li>
                <button class="toc-item-link active" data-category="all">
                  <span class="toc-item-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                    সমগ্র রচনাসমগ্র
                  </span>
                  <span class="toc-item-count">৭টি</span>
                </button>
              </li>
              <li>
                <button class="toc-item-link" data-category="সাহিত্য">
                  <span class="toc-item-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                    সাহিত্য ও কাব্য
                  </span>
                  <span class="toc-item-count">১৪টি</span>
                </button>
              </li>
              <li>
                <button class="toc-item-link" data-category="কথাসাহিত্য">
                  <span class="toc-item-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                    কথাসাহিত্য ও গল্প
                  </span>
                  <span class="toc-item-count">৯টি</span>
                </button>
              </li>
              <li>
                <button class="toc-item-link" data-category="দর্শন">
                  <span class="toc-item-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                    দর্শন ও সমাজভাবনা
                  </span>
                  <span class="toc-item-count">১২টি</span>
                </button>
              </li>
              <li>
                <button class="toc-item-link" data-category="বিজ্ঞান">
                  <span class="toc-item-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                    বিজ্ঞান ও প্রযুক্তি
                  </span>
                  <span class="toc-item-count">৮টি</span>
                </button>
              </li>
              <li>
                <button class="toc-item-link" data-category="ভ্রমণ">
                  <span class="toc-item-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                    ভ্রমণ ও ঐতিহ্য
                  </span>
                  <span class="toc-item-count">৭টি</span>
                </button>
              </li>
            </ul>
          </div>

          <!-- Popular / Trending Articles (জনপ্রিয় লেখা) -->
          <div class="widget">
            <h3 class="widget-title">
              <span>জনপ্রিয় লেখা</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
              </svg>
            </h3>
            <ul class="popular-list">
              <li class="popular-item" onclick="window.location.href='/single-post.html'">
                <span class="popular-rank">১</span>
                <div>
                  <h4 class="popular-item-title">রবীন্দ্রনাথের শেষ পর্বের কবিতা: রূপান্তরের আলো ও ছায়া</h4>
