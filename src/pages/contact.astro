---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// সোশ্যাল মিডিয়া লিংক এবং আইকন (এখান থেকে পরিবর্তন করতে পারবেন)
const socialLinks = [
  {
    name: 'Facebook',
    url: 'https://www.facebook.com/kalponik.oronno',
    iconSVG: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>`
  },
  {
    name: 'Twitter',
    url: 'https://twitter.com',
    iconSVG: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>`
  },
  {
    name: 'Instagram',
    url: 'https://instagram.com',
    iconSVG: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>`
  },
  {
    name: 'LinkedIn',
    url: 'https://linkedin.com',
    iconSVG: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>`
  }
];
---

<Layout title="যোগাযোগ - সুবর্ণপত্র">
  <Header />

  <main class="site-main" id="contact-page">
    <div class="container">
      <!-- Breadcrumbs -->
      <div class="breadcrumbs">
        <a href="/">প্রচ্ছদ</a>
        <span class="breadcrumbs-sep">/</span>
        <span>যোগাযোগ</span>
      </div>

      <!-- Page Header -->
      <div class="page-header">
        <h1 class="page-title">যোগাযোগ</h1>
        <p class="page-subtitle">আপনার যেকোনো প্রশ্ন, পরামর্শ বা মতামত আমাদের জানাতে পারেন। আমরা দ্রুত আপনার সাথে যোগাযোগ করার চেষ্টা করবো।</p>
      </div>

      <div class="contact-grid">
        <!-- Contact Form -->
        <div class="contact-form-card">
          <!-- FormSubmit URL using the provided email -->
          <form action="https://formsubmit.co/ornob336699@gmail.com" method="POST" class="contact-form">
            <!-- Honeypot -->
            <input type="text" name="_honey" style="display:none">
            <!-- Disable Captcha (Optional, for better UX) -->
            <input type="hidden" name="_captcha" value="false">
            <!-- Success Page (Optional, currently using FormSubmit default) -->

            <div class="form-row">
              <div class="form-group">
                <label for="name">নাম <span class="required">*</span></label>
                <input type="text" id="name" name="name" placeholder="আপনার নাম" required>
              </div>
              <div class="form-group">
                <label for="email">ইমেইল <span class="required">*</span></label>
                <input type="email" id="email" name="email" placeholder="আপনার ইমেইল ঠিকানা" required>
              </div>
            </div>

            <div class="form-group">
              <label for="subject">বিষয় <span class="required">*</span></label>
              <input type="text" id="subject" name="subject" placeholder="আপনি কোন বিষয়ে যোগাযোগ করতে চান?" required>
            </div>

            <div class="form-group">
              <label for="message">আপনার বার্তা <span class="required">*</span></label>
              <textarea id="message" name="message" rows="6" placeholder="বিস্তারিত লিখুন..." required></textarea>
            </div>

            <button type="submit" class="submit-btn">
              বার্তা পাঠান
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </form>
        </div>

        <!-- Contact Info Sidebar -->
        <div class="contact-info-sidebar">
          <div class="info-card">
            <h3 class="info-card-title">যোগাযোগের ঠিকানা</h3>
            
            <ul class="info-list">
              <li class="info-item">
                <div class="info-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                </div>
                <div class="info-content">
                  <strong>ফোন</strong>
                  <span>০১৭১২-১২৭৬৬৫</span>
                </div>
              </li>
              
              <li class="info-item">
                <div class="info-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                </div>
                <div class="info-content">
                  <strong>ইমেইল</strong>
                  <span>ornob336699@gmail.com</span>
                </div>
              </li>
            </ul>

            <div class="social-section">
              <h4 class="social-title">যুক্ত থাকুন</h4>
              <div class="social-links-grid">
                {socialLinks.map(social => (
                  <a href={social.url} target="_blank" rel="noopener noreferrer" class="social-icon-box" aria-label={social.name} set:html={social.iconSVG} />
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .page-header {
    margin-bottom: 3rem;
  }
  .page-title {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: 1rem;
  }
  .page-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 700px;
    line-height: 1.6;
  }
  
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2.5rem;
    align-items: start;
  }

  /* Form Styles */
  .contact-form-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .form-group label .required {
    color: var(--color-crimson);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background-color: var(--bg-page-subtle);
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--text-primary);
    transition: all var(--transition);
    outline: none;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--color-gold);
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(180, 114, 20, 0.15);
  }

  .submit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-gold);
    color: #ffffff;
    border: none;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    padding: 0.85rem 2rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition);
    box-shadow: 0 4px 12px rgba(180, 114, 20, 0.2);
  }

  .submit-btn:hover {
    background-color: #9c6211;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(180, 114, 20, 0.3);
  }

  /* Sidebar Styles */
  .info-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 6rem;
  }

  .info-card-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px dashed var(--border-subtle);
    color: var(--color-dark);
  }

  .info-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .info-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background-color: var(--color-gold-soft);
    color: var(--color-gold);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .info-content {
    display: flex;
    flex-direction: column;
  }

  .info-content strong {
    font-size: 1rem;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
  }

  .info-content span {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .social-section {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-light);
  }

  .social-title {
    font-size: 1.1rem;
    font-family: var(--font-serif);
    margin-bottom: 1rem;
    color: var(--color-dark);
  }

  .social-links-grid {
    display: flex;
    gap: 0.8rem;
  }

  .social-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: var(--bg-page-subtle);
    color: var(--text-secondary);
    border-radius: 50%;
    transition: all var(--transition);
  }

  .social-icon-box:hover {
    background-color: var(--color-gold);
    color: #ffffff;
    transform: translateY(-3px);
  }

  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .info-card {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .contact-form-card {
      padding: 1.5rem;
    }
    .page-title {
      font-size: 2rem;
    }
  }
</style>
