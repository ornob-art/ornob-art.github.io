---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getAutoDate, getAutoReadTime, getAutoBadge, toBengaliDigits, getPostViews, getPostTimestamp } from '../../utils';
import { Buffer } from 'node:buffer';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort((a, b) => getPostTimestamp(b) - getPostTimestamp(a));
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: { 
      post,
      prevPost: index > 0 ? posts[index - 1] : null,
      nextPost: index < posts.length - 1 ? posts[index + 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const hasPassword = !!post.data.password;

function encryptContent(text, pass) {
  if (!pass) return '';
  const textBytes = Buffer.from(text, 'utf-8');
  const passBytes = Buffer.from(pass, 'utf-8');
  
  const encryptedBytes = new Uint8Array(textBytes.length);
  for (let i = 0; i < textBytes.length; i++) {
    encryptedBytes[i] = textBytes[i] ^ passBytes[i % passBytes.length];
  }
  return Buffer.from(encryptedBytes).toString('base64');
}

const encryptedBody = hasPassword ? encryptContent(post.body, post.data.password) : null;
const expectedHash = hasPassword ? Buffer.from(post.data.password).toString('base64') : null;

const { Content } = await post.render();

const wordCountNum = (post.body || '').trim().split(/\s+/).length;
const wordCountBn = toBengaliDigits(wordCountNum);
const readTimeBn = getAutoReadTime(post);
const postDate = getAutoDate(post);
const postBadge = getAutoBadge(post);
const allPosts = await getCollection('posts');
const popularPosts = [...allPosts]
  .sort((a, b) => getPostViews(b) - getPostViews(a))
  .slice(0, 4);

const categoryCounts = allPosts.reduce((acc, p) => {
  const cat = p.data.category;
  acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {});

const categories = [
  { id: 'সাহিত্য', label: 'সাহিত্য ও কাব্য' },
  { id: 'কথাসাহিত্য', label: 'কথাসাহিত্য ও গল্প' },
  { id: 'দর্শন', label: 'দর্শন ও সমাজভাবনা' },
  { id: 'বিজ্ঞান', label: 'বিজ্ঞান ও প্রযুক্তি' },
  { id: 'ভ্রমণ', label: 'ভ্রমণ ও ঐতিহ্য' },
];
---

<Layout>
  <Header />

  <!-- Main Content Area -->
  <main class="site-main">
    <div class="container">
      
      <!-- Breadcrumbs -->
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">প্রচ্ছদ</a>
        <span class="breadcrumbs-sep">/</span>
        <a href="/#articles">{post.data.category}</a>
        <span class="breadcrumbs-sep">/</span>
        <span>{post.data.title}</span>
      </nav>

      <div class="layout-grid">
        
        <!-- Left Column: Detailed Single Article Content -->
        <div class="content-column">
          
          <article class="single-article">
            
            <!-- Article Header -->
            <header class="single-header">
              <span class="single-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                {postBadge}
              </span>

              <h1 class="single-title">
                {post.data.title}
              </h1>

              <div class="single-meta">
                <span class="meta-author">{post.data.author}</span>
                <span class="meta-dot">•</span>
                
                <span class="meta-item">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" x2="21" y1="10" y2="10"></line>
                  </svg>
                  {postDate}
                </span>
                <span class="meta-dot">•</span>

                <span class="meta-item">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  পড়ার সময়: {readTimeBn}
                </span>
                <span class="meta-dot">•</span>
                
                <span class="meta-item">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="21" y1="10" x2="3" y2="10"></line>
                    <line x1="21" y1="6" x2="3" y2="6"></line>
                    <line x1="21" y1="14" x2="3" y2="14"></line>
                    <line x1="21" y1="18" x2="3" y2="18"></line>
                  </svg>
                  {wordCountBn} শব্দ
                </span>
              </div>
            </header>

            {post.data.image && (
              <img src={post.data.image} alt={post.data.title} class="single-featured-img" />
            )}

            <div class="single-content">
              {hasPassword ? (
                <div id="password-protect-container" style="text-align: center; padding: 3rem 1rem; background: var(--bg-page-subtle); border-radius: 8px; margin: 2rem 0; border: 1px dashed var(--border-subtle);">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 1rem;">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                  <h3 style="font-family: var(--font-serif); margin-bottom: 0.5rem; color: var(--color-dark); font-size: 1.5rem;">এই লেখাটি সুরক্ষিত</h3>
                  <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">পড়তে চাইলে সঠিক পাসওয়ার্ড দিন:</p>
                  
                  <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; max-width: 400px; width: 100%; margin: 0 auto;">
                    <input type="password" id="post-password-input" placeholder="পাসওয়ার্ড দিন" style="padding: 0.75rem 1rem; border: 1px solid var(--border-subtle); border-radius: 4px; font-size: 1rem; outline: none; flex: 1 1 200px; box-sizing: border-box;">
                    <button id="post-unlock-btn" style="padding: 0.75rem 1.5rem; background: var(--color-gold); color: white; border: none; border-radius: 4px; font-size: 1rem; cursor: pointer; font-family: var(--font-serif); font-weight: 600; flex: 0 1 auto; box-sizing: border-box;">আনলক</button>
                  </div>
                  <p id="password-error-msg" style="color: red; display: none; margin-top: 10px;">ভুল পাসওয়ার্ড! আবার চেষ্টা করুন।</p>
                </div>
                
                <div id="decrypted-content-container" style="display: none;"></div>
                
                <script type="application/json" id="encrypted-post-data" set:html={JSON.stringify(encryptedBody)}></script>
                
                <!-- Client-side Markdown Parser -->
                <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js" is:inline></script>
                <script is:inline define:vars={{ expectedHash }}>
                  document.addEventListener('DOMContentLoaded', () => {
                    const btn = document.getElementById('post-unlock-btn');
                    const input = document.getElementById('post-password-input');
                    const error = document.getElementById('password-error-msg');
                    const container = document.getElementById('password-protect-container');
                    const contentDiv = document.getElementById('decrypted-content-container');
                    
                    const unlockPost = () => {
                      const pass = input.value;
                      if (btoa(pass) === expectedHash) {
                        try {
                          const encryptedStr = JSON.parse(document.getElementById('encrypted-post-data').textContent);
                          
                          // Base64 to bytes
                          const binaryString = atob(encryptedStr);
                          const encryptedBytes = new Uint8Array(binaryString.length);
                          for (let i = 0; i < binaryString.length; i++) {
                            encryptedBytes[i] = binaryString.charCodeAt(i);
                          }
                          
                          // Password to bytes
                          const encoder = new TextEncoder();
                          const passBytes = encoder.encode(pass);
                          
                          // XOR decrypt
                          const decryptedBytes = new Uint8Array(encryptedBytes.length);
                          for (let i = 0; i < encryptedBytes.length; i++) {
                            decryptedBytes[i] = encryptedBytes[i] ^ passBytes[i % passBytes.length];
                          }
                          
                          // Decode UTF-8 bytes to string
                          const decoder = new TextDecoder();
                          const decrypted = decoder.decode(decryptedBytes);
                          
                          contentDiv.innerHTML = marked.parse(decrypted);
                          container.style.display = 'none';
                          contentDiv.style.display = 'block';
                        } catch (e) {
                          error.style.display = 'block';
                        }
                      } else {
                        error.style.display = 'block';
                      }
                    };
                    
                    btn.addEventListener('click', unlockPost);
                    input.addEventListener('keypress', (e) => {
                      if (e.key === 'Enter') unlockPost();
                    });
                  });
                </script>
              ) : (
                <Content />
              )}
            </div>

            <div class="article-footer-toolbar">
              <div class="article-tags">
                <span class="tag-label">ট্যাগসমূহ:</span>
                <a href="/#articles" class="article-tag">#{post.data.category}</a>
              </div>

              <div class="share-bar">
                <span class="share-label">শেয়ার করুন:</span>
                <button class="share-btn" onclick="shareArticle('facebook')" aria-label="Share on Facebook">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                  </svg>
                </button>
                <button class="share-btn" onclick="shareArticle('twitter')" aria-label="Share on Twitter">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
                  </svg>
                </button>
                <button class="share-btn" onclick="copyArticleLink()" aria-label="Copy Link" id="copy-link-btn" title="লিঙ্ক কপি করুন">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                  </svg>
                </button>
              </div>
            </div>

            <div class="author-box">
              <div class="author-box-avatar">{post.data.author.charAt(0)}</div>
              <div class="author-box-info">
                <h4>{post.data.author}</h4>
                <p class="author-box-title">লেখক, সুবর্ণপত্রিকা</p>
                <p class="author-box-bio">
                  সুবর্ণপত্রিকার নিয়মিত লেখক হিসেবে সাহিত্য ও সমাজভাবনা বিষয়ে প্রবন্ধ লেখেন।
                </p>
              </div>
            </div>

            <div class="post-navigation">
              {prevPost ? (
                <a href={`/posts/${prevPost.slug}`} class="nav-card nav-prev">
                  <span class="nav-label">← পূর্ববর্তী রচনা</span>
                  <span class="nav-title">{prevPost.data.title}</span>
                </a>
              ) : <div class="nav-card empty-nav"></div>}
              
              {nextPost ? (
                <a href={`/posts/${nextPost.slug}`} class="nav-card nav-next">
                  <span class="nav-label">পরবর্তী রচনা →</span>
                  <span class="nav-title">{nextPost.data.title}</span>
                </a>
              ) : <div class="nav-card empty-nav"></div>}
            </div>
          </article>
        </div>

        <!-- Right Column: Sidebar (সূচীপত্র ও অনুষঙ্গ) -->
        <aside class="sidebar" aria-label="সূচীপত্র ও অনুষঙ্গ">
          
          <!-- Table of Contents / Categories (সূচীপত্র / বিষয়শ্রেণী) -->
          <div class="widget">
            <h3 class="widget-title">
              <span>সূচীপত্র / বিষয়শ্রেণী</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
            </h3>
            <ul class="toc-list" id="toc-list">
              <li>
                <button class="toc-item-link active" data-category="all">
                  <span class="toc-item-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                    সমগ্র রচনাসমগ্র
                  </span>
                  <span class="toc-item-count">{toBengaliDigits(allPosts.length)}টি</span>
                </button>
              </li>
              {categories.map(cat => (
                <li>
                  <button class="toc-item-link" data-category={cat.id}>
                    <span class="toc-item-title">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                      {cat.label}
                    </span>
                    <span class="toc-item-count">{toBengaliDigits(categoryCounts[cat.id] || 0)}টি</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>

          <!-- Popular / Trending Articles (জনপ্রিয় লেখা) -->
          <div class="widget">
            <h3 class="widget-title">
              <span style="display: flex; align-items: center; gap: 0.4rem;">
                জনপ্রিয় লেখা 
                <svg width="20" height="20" viewBox="0 0 24 24" fill="url(#fireGradient)" stroke="none">
                  <defs>
                    <linearGradient id="fireGradient" x1="0%" y1="100%" x2="0%" y2="0%">
                      <stop offset="0%" stop-color="#ea580c"/>
                      <stop offset="50%" stop-color="#f97316"/>
                      <stop offset="100%" stop-color="#fbbf24"/>
                    </linearGradient>
                  </defs>
                  <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
                </svg>
              </span>
            </h3>
            <ul class="popular-list">
              {popularPosts.map((popPost, idx) => (
                <li class="popular-item" onclick={`window.location.href='/posts/${popPost.slug}'`}>
                  <span class="popular-rank">{toBengaliDigits(idx + 1)}</span>
                  <div>
                    <h4 class="popular-item-title">{popPost.data.title}</h4>
                    <span class="popular-item-date">{getAutoDate(popPost)}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <!-- Weekly Literary Thought (সপ্তাহের সাহিত্য ভাবনা) -->
          <div class="widget quote-widget">
            <h3 class="widget-title">
              <span>সপ্তাহের ভাবনা</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
                <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
              </svg>
            </h3>
            <blockquote class="quote-body">
              “আলো যেমন আঁধারকে স্পর্শ করেই প্রকাশ পায়, তেমনি দুঃখের নিবিড় অনুভূতিই আনন্দের প্রকৃত স্বরূপকে চিনিয়ে দেয়।”
            </blockquote>
            <p class="quote-author">— রবীন্দ্রনাথ ঠাকুর</p>
          </div>

          
        </aside>


      </div>
    </div>
  </main>

  <Footer />
</Layout>




