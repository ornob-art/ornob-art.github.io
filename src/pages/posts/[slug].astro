---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getAutoDate, getAutoReadTime, getAutoBadge, toBengaliDigits } from '../../utils';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const wordCountNum = (post.body || '').trim().split(/\s+/).length;
const wordCountBn = toBengaliDigits(wordCountNum);
const readTimeBn = getAutoReadTime(post);
const postDate = getAutoDate(post);
const postBadge = getAutoBadge(post);
---

<Layout>
  <Header />

  <!-- Main Content Area -->
  <main class="site-main">
    <div class="container">
      
      <!-- Breadcrumbs -->
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">প্রচ্ছদ</a>
        <span class="breadcrumbs-sep">/</span>
        <a href="/#articles">{post.data.category}</a>
        <span class="breadcrumbs-sep">/</span>
        <span>{post.data.title}</span>
      </nav>

      <div class="layout-grid">
        
        <!-- Left Column: Detailed Single Article Content -->
        <div class="content-column">
          
          <article class="single-article">
            
            <!-- Article Header -->
            <header class="single-header">
              <span class="single-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                {postBadge}
              </span>

              <h1 class="single-title">
                {post.data.title}
              </h1>

              <div class="single-meta">
                <span class="meta-author">{post.data.author}</span>
                <span class="meta-dot">•</span>
                
                <span class="meta-item">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" x2="21" y1="10" y2="10"></line>
                  </svg>
                  {postDate}
                </span>
                <span class="meta-dot">•</span>

                <span class="meta-item">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  পড়ার সময়: {readTimeBn}
                </span>
                <span class="meta-dot">•</span>
                
                <span class="meta-item">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="21" y1="10" x2="3" y2="10"></line>
                    <line x1="21" y1="6" x2="3" y2="6"></line>
                    <line x1="21" y1="14" x2="3" y2="14"></line>
                    <line x1="21" y1="18" x2="3" y2="18"></line>
                  </svg>
                  {wordCountBn} শব্দ
                </span>
              </div>
            </header>

            {post.data.image && (
              <img src={post.data.image} alt={post.data.title} class="single-featured-img" />
            )}

            <div class="single-content">
              <Content />
            </div>

            <div class="article-footer-toolbar">
              <div class="article-tags">
                <span class="tag-label">ট্যাগসমূহ:</span>
                <a href="/#articles" class="article-tag">#{post.data.category}</a>
              </div>

              <div class="share-bar">
                <span class="share-label">শেয়ার করুন:</span>
                <button class="share-btn" onclick="shareArticle('facebook')" aria-label="Share on Facebook">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                  </svg>
                </button>
                <button class="share-btn" onclick="shareArticle('twitter')" aria-label="Share on Twitter">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
                  </svg>
                </button>
                <button class="share-btn" onclick="copyArticleLink()" aria-label="Copy Link" id="copy-link-btn" title="লিঙ্ক কপি করুন">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                  </svg>
                </button>
              </div>
            </div>

            <div class="author-box">
              <div class="author-box-avatar">{post.data.author.charAt(0)}</div>
              <div class="author-box-info">
                <h4>{post.data.author}</h4>
                <p class="author-box-title">লেখক, সুবর্ণপত্রিকা</p>
                <p class="author-box-bio">
                  সুবর্ণপত্রিকার নিয়মিত লেখক হিসেবে সাহিত্য ও সমাজভাবনা বিষয়ে প্রবন্ধ লেখেন।
                </p>
              </div>
            </div>
          </article>
        </div>

        <!-- Right Column: Sidebar (সূচীপত্র ও অনুষঙ্গ) -->
        <aside class="sidebar" aria-label="সূচীপত্র ও অনুষঙ্গ">
          
        </aside>

      </div>
    </div>
  </main>

  <Footer />
</Layout>



