---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="গোপনীয়তা নীতি | সুবর্ণপত্র">
  <Header />
  
  <main class="site-main">
    <div class="container" style="max-width: 800px; margin: 3rem auto; padding: 0 1rem;">
      <article class="single-article" style="background: var(--bg-page); padding: 3rem; border-radius: var(--radius-lg); box-shadow: 0 5px 25px rgba(0,0,0,0.03);">
        <header class="article-header" style="margin-bottom: 2.5rem; text-align: center; border-bottom: 1px solid var(--border-subtle); padding-bottom: 2rem;">
          <h1 class="single-title">গোপনীয়তা নীতি (Privacy Policy)</h1>
          <div class="article-meta" style="justify-content: center; margin-top: 1rem;">
            <span>সর্বশেষ আপডেট: অক্টোবর ২০২৬</span>
          </div>
        </header>

        <div class="article-content" style="font-size: 1.1rem; line-height: 1.8; color: var(--text-primary);">
          
          <p><strong>সুবর্ণপত্র</strong>-এ স্বাগতম। একটি সাহিত্য ও শিল্প বিষয়ক প্ল্যাটফর্ম হিসেবে পাঠকদের ব্যক্তিগত তথ্যের সুরক্ষা এবং গোপনীয়তা বজায় রাখা আমাদের অন্যতম প্রধান দায়িত্ব। আমাদের ওয়েবসাইটটি ভিজিট করার সময় আপনার ব্যক্তিগত তথ্য কীভাবে সংগ্রহ, ব্যবহার এবং সুরক্ষিত করা হয়, তা এই নীতিমালায় বিস্তারিত বলা হয়েছে।</p>

          <h3 style="margin-top: 2rem; margin-bottom: 1rem; color: var(--text-title); font-size: 1.4rem;">১. আমরা কী ধরনের তথ্য সংগ্রহ করি?</h3>
          <p>সাধারণত আপনি আমাদের ওয়েবসাইটটি ব্যক্তিগত কোনো তথ্য প্রদান না করেই ভিজিট করতে পারেন। তবে কিছু ক্ষেত্রে আমরা নিম্নোক্ত তথ্য সংগ্রহ করতে পারি:</p>
          <ul style="margin-left: 2rem; margin-bottom: 1.5rem;">
            <li><strong>অ-ব্যক্তিগত তথ্য:</strong> আমাদের ওয়েবসাইটে আপনার ব্রাউজিং অভিজ্ঞতা উন্নত করার জন্য আমরা ব্রাউজারের ধরন, ডিভাইসের ধরন, আইপি (IP) ঠিকানা এবং পেজ ভিজিটের সময়কালের মতো কিছু সাধারণ লগ ডেটা সংগ্রহ করতে পারি।</li>
            <li><strong>ব্যক্তিগত তথ্য:</strong> আপনি যদি আমাদের সাথে যোগাযোগ করেন, তবে আপনার নাম, ইমেইল ঠিকানা বা বার্তার বিষয়বস্তু সংরক্ষিত হতে পারে।</li>
          </ul>

          <h3 style="margin-top: 2rem; margin-bottom: 1rem; color: var(--text-title); font-size: 1.4rem;">২. তথ্যের ব্যবহার</h3>
          <p>আমরা সংগৃহীত তথ্য শুধুমাত্র নিচের কাজগুলোর জন্য ব্যবহার করি:</p>
          <ul style="margin-left: 2rem; margin-bottom: 1.5rem;">
            <li>ওয়েবসাইটের কন্টেন্ট এবং মান উন্নয়ন করার জন্য।</li>
            <li>পাঠকের রুচি ও চাহিদা সম্পর্কে ধারণা পাওয়ার জন্য।</li>
            <li>আপনার করা কোনো প্রশ্ন বা মন্তব্যের উত্তর দেওয়ার জন্য।</li>
          </ul>

          <h3 style="margin-top: 2rem; margin-bottom: 1rem; color: var(--text-title); font-size: 1.4rem;">৩. কুকিজ (Cookies)</h3>
          <p>আপনার ব্রাউজিং অভিজ্ঞতাকে আরো সহজ ও দ্রুত করার জন্য আমাদের ওয়েবসাইট 'কুকিজ' ব্যবহার করতে পারে। কুকিজ হলো ছোট ডেটা ফাইল, যা আপনার ডিভাইসে সংরক্ষিত থাকে। আপনি চাইলে আপনার ব্রাউজার সেটিংস থেকে কুকিজ বন্ধ করে রাখতে পারেন, তবে এতে সাইটের কিছু ফিচার ঠিকমতো কাজ না-ও করতে পারে।</p>

          <h3 style="margin-top: 2rem; margin-bottom: 1rem; color: var(--text-title); font-size: 1.4rem;">৪. থার্ড-পার্টি লিংক</h3>
          <p>আমাদের ওয়েবসাইটে মাঝে মাঝে অন্যান্য ওয়েবসাইট বা সোশ্যাল মিডিয়ার লিংক থাকতে পারে (যেমন- ফেসবুক, টুইটার বা ইউটিউব)। এসব থার্ড-পার্টি ওয়েবসাইটের গোপনীয়তা নীতির জন্য আমরা দায়বদ্ধ নই। অন্য সাইটে ভিজিট করার ক্ষেত্রে তাদের গোপনীয়তা নীতি পড়ে নেওয়ার অনুরোধ করা হলো।</p>

          <h3 style="margin-top: 2rem; margin-bottom: 1rem; color: var(--text-title); font-size: 1.4rem;">৫. তথ্যের নিরাপত্তা</h3>
          <p>আপনার ব্যক্তিগত তথ্যের নিরাপত্তা আমাদের কাছে অত্যন্ত গুরুত্বপূর্ণ। তথ্য চুরি বা অপব্যবহার রোধ করতে আমরা বাণিজ্যিকভাবে গ্রহণযোগ্য সর্বোচ্চ সতর্কতামূলক ব্যবস্থা গ্রহণ করে থাকি। তবে ইন্টারনেটের মাধ্যমে ডেটা আদান-প্রদান শতভাগ সুরক্ষিত নয়, তাই আমরা এর নিরঙ্কুশ নিরাপত্তার নিশ্চয়তা দিতে পারি না।</p>

          <h3 style="margin-top: 2rem; margin-bottom: 1rem; color: var(--text-title); font-size: 1.4rem;">৬. নীতিমালার পরিবর্তন</h3>
          <p>প্রয়োজন সাপেক্ষে যেকোনো সময় এই গোপনীয়তা নীতি পরিবর্তন বা আপডেট করার অধিকার 'সুবর্ণপত্র' সংরক্ষণ করে। বড় ধরনের কোনো পরিবর্তন হলে তা এই পেজে প্রকাশ করে জানিয়ে দেওয়া হবে।</p>

          <h3 style="margin-top: 2rem; margin-bottom: 1rem; color: var(--text-title); font-size: 1.4rem;">৭. যোগাযোগ</h3>
          <p>এই গোপনীয়তা নীতি সম্পর্কে আপনার যদি কোনো প্রশ্ন বা পরামর্শ থাকে, তবে অনুগ্রহ করে আমাদের সাথে যোগাযোগ করুন:</p>
          <p><strong>ইমেইল:</strong> ornob336699@gmail.com</p>

        </div>
      </article>
    </div>
  </main>
  
  <Footer />
</Layout>
