<!-- Site Footer -->
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <h2 class="brand-title">সুবর্ণ<span>পত্র</span></h2>
        <p>
          সুবর্ণপত্র বাংলা ভাষার মননশীল প্রবন্ধ, বিশুদ্ধ কথাসাহিত্য, দর্শন, ইতিহাস ও বিজ্ঞানচিন্তার এক উন্মুক্ত নন্দিত প্রাঙ্গণ। শব্দের গভীরতায় আমরা সত্য ও সৌন্দর্যের সন্ধান করি।
        </p>
      </div>

      <div>
        <h4 class="footer-col-title">সূচীপত্র</h4>
        <ul class="footer-links">
          <li><a href="/#articles" data-category="সাহিত্য">সাহিত্য ও কাব্য</a></li>
          <li><a href="/#articles" data-category="কথাসাহিত্য">কথাসাহিত্য ও গল্প</a></li>
          <li><a href="/#articles" data-category="দর্শন">দর্শন ও সমাজভাবনা</a></li>
          <li><a href="/#articles" data-category="বিজ্ঞান">বিজ্ঞান ও প্রযুক্তি</a></li>
          <li><a href="/#articles" data-category="ভ্রমণ">ভ্রমণ ও ঐতিহ্য</a></li>
        </ul>
